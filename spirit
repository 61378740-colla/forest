<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>森林精灵 · 语音运动小伙伴</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,-apple-system;
-webkit-touch-callout:none;
-webkit-user-select:none;
user-select:none;
}
body{
  min-height:100vh;
  background:linear-gradient(180deg,#d7f0da,#f0f9f2);
  padding:20px;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.title{
  font-size:20px;
  color:#2b5030;
  margin-bottom:16px;
  font-weight:600;
}
.spirit-container{
  position:relative;
  width:220px;
  height:280px;
  margin-bottom:20px;
  cursor:pointer;
}
.spirit-glow{
  position:absolute;
  top:-15px;left:-15px;right:-15px;bottom:-15px;
  background:radial-gradient(circle,rgba(255,235,160,0.5),transparent 60%);
  animation:breath 2.5s ease-in-out infinite;
}
.spirit-img{
  width:100%;
  height:100%;
  object-fit:contain;
  transition:transform 0.3s ease;
  filter:drop-shadow(0 4px 12px rgba(180,220,180,0.4));
}
.spirit-img.wave{animation:wave 0.7s ease;}
.spirit-img.jump{animation:jump 0.6s ease;}
.spirit-img.cheer{animation:cheer 0.8s ease;}
@keyframes breath{0%,100%{opacity:0.55;}50%{opacity:1;}}
@keyframes jump{0%,100%{transform:translateY(0);}45%{transform:translateY(-12px);}}
@keyframes wave{0%,100%{transform:rotate(0deg);}30%{transform:rotate(-7deg);}70%{transform:rotate(7deg);}}
@keyframes cheer{0%,100%{transform:scale(1);}50%{transform:scale(1.08);}}
.bubble{
  position:absolute;
  top:-20px;
  left:50%;
  transform:translateX(-50%) scale(0);
  background:#fff;
  border:2px solid #b0d8b6;
  border-radius:16px;
  padding:10px 14px;
  color:#2b5030;
  font-size:15px;
  max-width:240px;
  text-align:center;
  box-shadow:0 4px 10px rgba(0,0,0,0.08);
  transition:transform 0.25s ease;
}
.bubble.show{transform:translateX(-50%) scale(1);}
.particle{
  position:absolute;
  font-size:18px;
  pointer-events:none;
  animation:floatUp 1s ease-out forwards;
}
@keyframes floatUp{0%{opacity:0;transform:translateY(0) scale(0.6);}20%{opacity:1;}100%{opacity:0;transform:translateY(-60px) scale(1);}}
.chat-wrap{
  width:100%;
  max-width:420px;
  margin-top:10px;
  flex:1;
  display:flex;
  flex-direction:column;
}
.chat-box{
  flex:1;
  background:rgba(255,255,255,0.85);
  border-radius:14px;
  padding:14px;
  min-height:140px;
  margin-bottom:16px;
  overflow-y:auto;
  border:1px solid #c8e4cc;
  -webkit-user-select:auto;
  user-select:auto;
}
.msg{margin:6px 0;line-height:1.45;}
.msg-me{text-align:right;color:#244728;}
.msg-spirit{text-align:left;color:#336b39;}
.mic-btn{
  width:100px;height:100px;
  border-radius:50%;border:none;
  background:#64a86e;color:white;font-size:32px;
  margin:0 auto;display:block;
  box-shadow:0 4px 12px rgba(80,140,90,0.35);
  -webkit-touch-callout:none;
  -webkit-user-select:none;
  user-select:none;
}
.mic-btn.rec{background:#d65c5c;animation:pulse 0.8s infinite;}
@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}
.hint{margin-top:12px;text-align:center;color:#4b7c52;font-size:14px;}
</style>
</head>
<body>
<div class="title">🌿森林精灵 · 语音运动小伙伴</div>
<div class="spirit-container" id="spiritWrap">
  <div class="spirit-glow"></div>
  <div class="bubble" id="bubble">嗨！和我说说你今<img src="data:image/jpeg;base64,"/>" alt="森林精灵">
</div>
<div class="chat-wrap">
  <div class="chat-box" id="chatBox">
    <div class="msg msg-spirit">精灵：你好呀！点下面麦克风和我说话🥰</div>
  </div>
  <button class="mic-btn" id="micBtn">🎤</button>
  <div class="hint">点麦克风说话，可以说：我要出去运动了 / 我回来啦</div>
</div>

<script>
document.addEventListener('contextmenu',function(e){
  e.preventDefault();
});

var spiritWrap = document.getElementById('spiritWrap');
var spiritImg = document.getElementById('spiritImg');
var bubble = document.getElementById('bubble');
var chatBox = document.getElementById('chatBox');
var micBtn = document.getElementById('micBtn');

var praiseLib = [
  {cn:"哇！你太棒啦，坚持运动真勇敢🍃",en:"Wow! You are amazing, so brave!"},
  {cn:"太厉害啦！你的小身体充满力量✨",en:"Excellent! You are full of energy!"},
  {cn:"做得真好！继续加油，小小探险家💪",en:"Well done! Keep going, little explorer!"},
  {cn:"我看到啦！你认真运动的样子超可爱🥰",en:"I see! You look so lovely while moving!"},
  {cn:"你真的很努力！给你大大的赞🌟",en:"You tried so hard! Thumbs up!"}
];
var clickWords = [
  {cn:"嗨，我们一起来运动吧！",en:"Hi, let's move together!"},
  {cn:"准备好了吗？出发探险！",en:"Ready? Let's explore!"}
];

function speakText(text, isEn) {
  window.speechSynthesis.cancel();
  var utter = new SpeechSynthesisUtterance(text);
  if(isEn){
    utter.lang = "en-US";
  }else{
    utter.lang = "zh-CN";
  }
  utter.rate = 0.9;
  speechSynthesis.speak(utter);
}

function playAnim(type){
  spiritImg.classList.remove('wave','jump','cheer');
  var temp = spiritImg.offsetWidth;
  spiritImg.classList.add(type);
}

function showBubble(text){
  bubble.innerText = text;
  bubble.classList.add('show');
  setTimeout(function(){
    bubble.classList.remove('show');
  },2200);
  var stars = ['✨','💫','🌟','🍃'];
  for(var i=0;i<4;i++){
    var p = document.createElement('div');
    p.className = 'particle';
    p.innerText = stars[Math.floor(Math.random()*stars.length)];
    p.style.left = (20 + Math.random()*160)+'px';
    p.style.top = (60 + Math.random()*120)+'px';
    spiritWrap.appendChild(p);
    setTimeout(function(){
      p.remove();
    },1000);
  }
}

spiritWrap.onclick = function(){
  var r = clickWords[Math.floor(Math.random()*clickWords.length)];
  var txt;
  var isEn;
  if(Math.random()>0.5){
    txt = r.cn;
    isEn = false;
  }else{
    txt = r.en;
    isEn = true;
  }
  playAnim('wave');
  showBubble(txt);
  speakText(txt,isEn);
}

var recognition;
if ('webkitSpeechRecognition' in window) {
  recognition = new webkitSpeechRecognition();
  recognition.lang = "zh-CN";
  recognition.continuous = false;
  recognition.interimResults = false;

  recognition.onresult = function(e){
    var text = e.results[0][0].transcript.trim();
    chatBox.innerHTML = chatBox.innerHTML + '<div class="msg msg-me">我：'+text+'</div>';
    chatBox.scrollTop = chatBox.scrollHeight;
    var reply;
    var animType = "jump";
    var isEnglish = false;
    var lower = text.toLowerCase();
    if(lower.indexOf("出去运动")!==-1 || lower.indexOf("要出发")!==-1 || lower.indexOf("去探险")!==-1){
      reply = "好哦！探险前记得做好准备，穿好鞋子，我们一起出发吧🌿";
      animType = "wave";
    }else if(lower.indexOf("回来啦")!==-1 || lower.indexOf("回来了")!==-1){
      reply = "欢迎回来，小探险家！记得擦擦汗、喝点温水，好好休息一下✨";
      animType = "cheer";
    }else if(lower.indexOf("跳")!==-1 || lower.indexOf("跑")!==-1 || lower.indexOf("爬")!==-1 || lower.indexOf("运动")!==-1){
      var p = praiseLib[Math.floor(Math.random()*praiseLib.length)];
      if(Math.random()>0.5){
        isEnglish = true;
        reply = p.en;
      }else{
        isEnglish = false;
        reply = p.cn;
      }
      animType = "cheer";
    }else{
      reply = "哇，原来是这样！不管什么时候，我都陪着你哦🍃";
      animType = "jump";
    }
    setTimeout(function(){
      chatBox.innerHTML = chatBox.innerHTML + '<div class="msg msg-spirit">精灵：'+reply+'</div>';
      chatBox.scrollTop = chatBox.scrollHeight;
      playAnim(animType);
      showBubble(reply);
      speakText(reply,isEnglish);
    },300);
  }
  recognition.onend = function(){
    micBtn.classList.remove('rec');
  }
  recognition.onerror = function(){
    micBtn.classList.remove('rec');
  }
}

micBtn.onclick = function(){
  if(!recognition){
    alert("你的浏览器不支持语音识别，请用手机自带浏览器打开！");
    return;
  }
  micBtn.classList.add('rec');
  recognition.start();
}
</script>
</body>
</html>
